[Unit]
Description=GPU Safety Guardian
After=multi-user.target
ConditionPathExists=/usr/bin/nvidia-smi

[Service]
Type=simple
ExecStart=__GPU_MONITOR_INSTALL_DIR__/scripts/gpu_guardian_daemon.sh

Restart=always
RestartSec=5

User=root
Group=root

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
